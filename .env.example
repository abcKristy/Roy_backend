# Copy to .env for local use and replace every placeholder. Do not commit .env.
POSTGRES_DB=roy
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
# For local development, DATABASE_USER and DATABASE_PASSWORD must match POSTGRES_USER and POSTGRES_PASSWORD.
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/roy
DATABASE_USER=replace-me
DATABASE_PASSWORD=replace-me
JWT_SECRET=replace-with-a-long-random-secret
SERVER_PORT=8080
